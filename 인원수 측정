class TimerScreen(Screen):
    status_text = StringProperty('정지')
    timer_ev = None

    def start_timer(self, minutes_text):
        try:
            m = int(minutes_text)
            if m<=0: return
        except:
            return
        self.stop_timer()
        self.status_text = f'실행중 ({m}분)'
        # schedule interval in seconds
        self.timer_ev = Clock.schedule_interval(lambda dt: self._on_tick(), m*60)

    def stop_timer(self):
        if self.timer_ev:
            self.timer_ev.cancel(); self.timer_ev = None
        self.status_text = '정지'

    def _on_tick(self):
        # 자동 측정: 카메라 자동 촬영 또는 서버 연동 필요. 여기서는 시뮬레이션.
        simulated_current = max(0, int(10 + (time.time()%10)))
        simulated_total = simulated_current + 2
        simulated_absent = simulated_total - simulated_current
        recs = load_json(RECORDS_FILE, [])
        rec = {'id': int(time.time()*1000), 'time': datetime.now().isoformat(), 'current':simulated_current, 'total':simulated_total, 'absent':simulated_absent}
        recs.insert(0, rec); save_json(RECORDS_FILE, recs)
