<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    tools:context=".SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 화면 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ 설정"
            android:textSize="28sp"
            android:textColor="#1E293B"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- ============== 1. 사용자 프로필 카드 ============== -->
        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/iv_profile_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_profile_icon"
                    android:padding="16dp"
                    android:src="@drawable/ic_user"
                    app:tint="?attr/colorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="프로필 아이콘" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/iv_profile_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_edit_profile">
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="#1E293B"
                        android:textStyle="bold"
                        tools:text="홍길동" />
                    <TextView
                        android:id="@+id/tv_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        tools:text="gildong@gnu.ac.kr" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_edit_profile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="편집"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============== 2. 앱 설정 카드 ============== -->
        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="앱 설정"
                    android:textSize="18sp"
                    android:textColor="#1E293B"
                    android:textStyle="bold"/>

                <LinearLayout style="@style/SettingsItem">
                    <ImageView style="@style/SettingsItem.Icon" android:src="@drawable/ic_moon"/>
                    <LinearLayout style="@style/SettingsItem.TextContainer">
                        <TextView style="@style/SettingsItem.Title" android:text="다크 모드"/>
                        <TextView style="@style/SettingsItem.Subtitle" android:text="어두운 테마 사용"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_dark_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View style="@style/SettingsDivider"/>

                <LinearLayout style="@style/SettingsItem">
                    <ImageView style="@style/SettingsItem.Icon" android:src="@drawable/ic_bell"/>
                    <LinearLayout style="@style/SettingsItem.TextContainer">
                        <TextView style="@style/SettingsItem.Title" android:text="알림"/>
                        <TextView style="@style/SettingsItem.Subtitle" android:text="푸시 알림 받기"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_notifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============== 3. 기타 메뉴 카드 ============== -->
        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="기타"
                    android:textSize="18sp"
                    android:textColor="#1E293B"
                    android:textStyle="bold"/>

                <TextView style="@style/SettingsItem.Button" android:text="개인정보 처리방침" app:drawableStartCompat="@drawable/ic_shield" />
                <TextView style="@style/SettingsItem.Button" android:text="이용약관" app:drawableStartCompat="@drawable/ic_info" />
                <TextView style="@style/SettingsItem.Button" android:text="도움말" app:drawableStartCompat="@drawable/ic_help" />

                <View style="@style/SettingsDivider"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp">
                    <TextView
                        style="@style/SettingsItem.Title"
                        android:layout_alignParentStart="true"
                        android:text="버전"/>
                    <TextView
                        android:id="@+id/tv_version"
                        style="@style/SettingsItem.Subtitle"
                        android:layout_alignParentEnd="true"
                        tools:text="1.0.0"/>
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============== 4. 로그아웃 버튼 ============== -->
        <Button
            android:id="@+id/btn_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="로그아웃"
            android:textColor="#EF4444"
            app:icon="@drawable/ic_logout"
            app:iconTint="#EF4444"
            app:strokeColor="#FCA5A5" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
