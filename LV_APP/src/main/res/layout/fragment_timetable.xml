<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/timetableRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f4f8"
    tools:context=".TimetableFragment">

    <!-- 헤더 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/titleTimetable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 시간표"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <TextView
            android:id="@+id/subTitleTimetable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주간 수업 일정을 확인하세요"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:textColor="#64748B" />
    </LinearLayout>

    <!-- 내용 스크롤 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp"
            android:orientation="vertical">

            <!-- 시간표 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/timetableCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 요일 헤더 (5개 열 균등 분할) -->
                    <LinearLayout
                        android:id="@+id/dayHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#F8FAFC"
                        android:paddingVertical="12dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="월" android:textColor="#64748B" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="화" android:textColor="#64748B" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="수" android:textColor="#64748B" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="목" android:textColor="#64748B" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="금" android:textColor="#64748B" android:textStyle="bold"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>

                    <!-- 시간표 본문 (RecyclerView 복원) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewTimetable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:padding="4dp"
                        tools:itemCount="20"
                        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        tools:spanCount="5" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 팁 영역 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tipArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡"
                            android:textSize="18sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:text="도움말"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1E293B"/>
                    </LinearLayout>

                    <TextView
                        android:text="• 수업 카드에 마우스를 올리면 삭제 버튼이 나타납니다."
                        android:textSize="13sp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:text="• 수업 시간에 따라 카드 높이가 자동으로 조정됩니다."
                        android:textSize="13sp"
                        android:textColor="#64748B"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 수업 추가 버튼 (ID: buttonAddClass) -->
            <Button
                android:id="@+id/buttonAddClass"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="수업 추가하기"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="24dp"
                app:backgroundTint="#0ea5e9"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>