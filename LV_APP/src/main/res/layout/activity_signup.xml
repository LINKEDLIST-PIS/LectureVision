<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data></data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f5f5f5"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- 상단 로고/타이틀 -->
            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lecture Vision"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="24dp" />

            <!-- 카드 내부에 폼 넣기 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:padding="16dp"
                android:background="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 이름 -->
                    <EditText
                        android:id="@+id/editSignupName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="이름"
                        android:padding="12dp"
                        android:background="@drawable/bg_input"
                        android:layout_marginBottom="12dp" />

                    <!-- 이메일 + 전송 버튼 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/editSignupEmail"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:hint="이메일"
                            android:padding="12dp"
                            android:background="@drawable/bg_input" />

                        <Button
                            android:id="@+id/buttonSendCode"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="전송"
                            android:backgroundTint="#0ea5e9"
                            android:textColor="#ffffff"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- 비밀번호 -->
                    <EditText
                        android:id="@+id/editSignupPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="비밀번호"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:background="@drawable/bg_input"
                        android:layout_marginBottom="24dp" />

                    <!-- 회원가입 버튼 -->
                    <Button
                        android:id="@+id/buttonSignup"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="회원가입"
                        android:backgroundTint="#0ea5e9"
                        android:textColor="#ffffff"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 하단 안내 문구 -->
            <TextView
                android:id="@+id/textFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로그인하면 서비스 이용약관에 동의하게 됩니다."
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>
</layout>
