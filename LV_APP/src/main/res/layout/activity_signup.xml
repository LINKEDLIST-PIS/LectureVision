<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data></data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f5f5f5"
        android:fitsSystemWindows="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- 상단 로고/타이틀 -->
                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="LectureVision"
                    android:textColor="#1E293B"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- 카드 내부에 폼 넣기 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@color/white"
                    android:padding="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 이름 -->
                        <EditText
                            android:id="@+id/editSignupName"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_input"
                            android:hint="이름"
                            android:inputType="textPersonName"
                            android:padding="12dp" />

                        <!-- 이메일 -->
                        <EditText
                            android:id="@+id/editSignupEmail"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:hint="GNU 이메일 (@gnu.ac.kr)"
                            android:inputType="textEmailAddress"
                            android:padding="12dp" />

                        <!-- 비밀번호 -->
                        <EditText
                            android:id="@+id/editSignupPassword"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_input"
                            android:hint="비밀번호"
                            android:inputType="textPassword"
                            android:padding="12dp" />
                        
                        <!-- 비밀번호 확인 -->
                        <EditText
                            android:id="@+id/editSignupPasswordConfirm"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_input"
                            android:hint="비밀번호 확인"
                            android:inputType="textPassword"
                            android:padding="12dp" />

                        <!-- 이용약관 동의 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            
                            <CheckBox
                                android:id="@+id/checkTerm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="이용약관 동의 (필수)" />
                                
                            <TextView
                                android:id="@+id/btnShowTerm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[보기]"
                                android:textColor="#0ea5e9"
                                android:layout_marginStart="8dp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- 개인정보처리방침 동의 -->
                         <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="24dp">
                            
                            <CheckBox
                                android:id="@+id/checkPrivacy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="개인정보처리방침 동의 (필수)" />
                                
                            <TextView
                                android:id="@+id/btnShowPrivacy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[보기]"
                                android:textColor="#0ea5e9"
                                android:layout_marginStart="8dp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- 회원가입 버튼 -->
                        <Button
                            android:id="@+id/buttonSignup"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="#0ea5e9"
                            android:text="이메일로 인증 및 회원가입"
                            android:textColor="#ffffff"
                            android:textStyle="bold" />

                        <!-- 로그인하러 가기 텍스트 -->
                        <TextView
                            android:id="@+id/textLoginLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:padding="8dp"
                            android:text="이미 계정이 있으신가요? 로그인하러 가기"
                            android:textColor="#0ea5e9"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- 로딩 인디케이터 -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>
</layout>
