<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Lecture_project" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sky_blue_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <!-- 스플래시 테마 -->
    <style name="Theme.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 기존 투명 처리 -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        
        <!-- 안드로이드 12+ 스플래시 스크린 대응 -->
        <!-- 배경을 흰색으로 설정하여 시스템 스플래시와 자연스럽게 연결 -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/white</item>
        <!-- 아이콘을 투명하게 설정하여 안드로이드 기본 아이콘 숨김 -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
        <!-- 스플래시 지속 시간을 0으로 설정 -->
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
    </style>
</resources>
