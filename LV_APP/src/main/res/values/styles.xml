<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 기본 버튼 스타일 -->
    <style name="MyButtonStyle">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 시간표 헤더 스타일 -->
    <style name="TimetableHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 기록 화면 아이템 스타일 -->
    <style name="RecordItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="RecordItemTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>
    <style name="RecordItemValue">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#0ea5e9</item>
    </style>
    <style name="RecordItemValueDark">
        <item name="android:textColor">#1E293B</item>
    </style>
    <style name="RecordItemValueRed">
        <item name="android:textColor">#EF4444</item>
    </style>

</resources>
