RECORDS_FILE = os.path.join(DATA_DIR, 'records.json')
USERS_FILE = os.path.join(DATA_DIR, 'users.json')

# Helper I/O
def load_json(path, default):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return default

def save_json(path, data):
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

# Screens
class LoginScreen(Screen):
    def attempt_login(self, email, password):
        if not email or not password:
            from kivy.uix.popup import Popup
            from kivy.uix.label import Label
            Popup(title='오류', content=Label(text='이메일과 비밀번호를 입력하세요'), size_hint=(.8,.3)).open()
            return
        users = load_json(USERS_FILE, [])
        found = None
        for u in users:
            if u.get('email')==email and u.get('password')==password:
                found = u; break
        if found:
            App.get_running_app().current_user = found
            App.get_running_app().root.current = 'home'
        else:
            Popup(title='로그인 실패', content=Label(text='계정이 없거나 비밀번호가 틀립니다'), size_hint=(.8,.3)).open()

class SignupScreen(Screen):
    def signup(self, name, phone, email, password):
        if not (name and phone and email and password):
            from kivy.uix.popup import Popup
            from kivy.uix.label import Label
            Popup(title='오류', content=Label(text='모든 항목을 입력하세요'), size_hint=(.8,.3)).open()
            return
        users = load_json(USERS_FILE, [])
        users.append({'id': int(time.time()*1000), 'name':name, 'phone':phone, 'email':email, 'password':password})
        save_json(USERS_FILE, users)
        from kivy.uix.popup import Popup
        from kivy.uix.label import Label
        Popup(title='완료', content=Label(text='회원가입 완료'), size_hint=(.8,.3)).open()
        App.get_running_app().root.current = 'login'

class HomeScreen(Screen):
    class_title = StringProperty('강의명: (설정 없음)')
    clock_text = StringProperty('--:--:--')
    current_count = NumericProperty(0)
    total_count = NumericProperty(0)
    absent_count = NumericProperty(0)

    def on_enter(self):
        Clock.schedule_interval(self._tick, 1)
        self.load_stats()

    def on_leave(self):
        Clock.unschedule(self._tick)

    def _tick(self, dt):
        self.clock_text = datetime.now().strftime('%H:%M:%S')

    def load_stats(self):
        records = load_json(RECORDS_FILE, [])
        if records:
            last = records[0]
            self.current_count = last.get('current',0)
            self.total_count = last.get('total',0)
            self.absent_count = last.get('absent',0)

    def manual_measure(self):
        # 간단한 팝업으로 수동 입력
        from kivy.uix.popup import Popup
        from kivy.uix.boxlayout import BoxLayout
        from kivy.uix.textinput import TextInput
        from kivy.uix.button import Button
        from kivy.uix.label import Label
        box = BoxLayout(orientation='vertical', spacing=8)
        ti_cur = TextInput(hint_text='현재 인원', input_filter='int', multiline=False)
        ti_total = TextInput(hint_text='총 인원', input_filter='int', multiline=False)
        ti_abs = TextInput(hint_text='결석', input_filter='int', multiline=False)
        btn = Button(text='저장', size_hint_y=None, height='40dp')
        box.add_widget(ti_cur); box.add_widget(ti_total); box.add_widget(ti_abs); box.add_widget(btn)
        p = Popup(title='수동 측정', content=box, size_hint=(.9,.6))
        def on_save(instance):
            try:
                cur = int(ti_cur.text or '0'); tot = int(ti_total.text or '0'); absn = int(ti_abs.text or '0')
            except:
                return
            recs = load_json(RECORDS_FILE, [])
            rec = {'id': int(time.time()*1000), 'time': datetime.now().isoformat(), 'current':cur, 'total':tot, 'absent':absn}
            recs.insert(0, rec); save_json(RECORDS_FILE, recs)
            self.load_stats(); p.dismiss()
        btn.bind(on_release=on_save)
        p.open()

    def camera_measure(self):
        # 카메라 촬영 후 API 업로드/응답 처리
        if platform == 'android' or camera:
            fname = os.path.join(DATA_DIR, f'measure_{int(time.time())}.jpg')
            try:
                if camera:
                    camera.take_picture(filename=fname, on_complete=lambda x: self._on_camera_taken(x))
                else:
                    from kivy.uix.popup import Popup
                    from kivy.uix.label import Label
                    Popup(title='카메라 없음', content=Label(text='카메라 라이브러리를 사용할 수 없습니다.'), size_hint=(.8,.4)).open()
            except Exception as e:
                from kivy.uix.popup import Popup
                from kivy.uix.label import Label
                Popup(title='오류', content=Label(text=str(e)), size_hint=(.8,.4)).open()
        else:
            # 데스크탑 테스트:파일 선택
            if filechooser:
                filechooser.open_file(on_selection=lambda x: self._on_camera_taken(x[0] if x else None))
            else:
                from kivy.uix.popup import Popup
                from kivy.uix.label import Label
                Popup(title='테스트 모드', content=Label(text='테스트 환경에서 카메라 사용 불가'), size_hint=(.8,.4)).open()

    def _on_camera_taken(self, filepath):
        # filepath가 None이면 실패
        if not filepath:
            from kivy.uix.popup import Popup
            from kivy.uix.label import Label
            Popup(title='취소', content=Label(text='사진이 없습니다'), size_hint=(.8,.3)).open(); return
        # 서버로 업로드하여 결과 받기 (사용자 서버 URL로 변경 필요)
        self._show_msg('업로드 시작')
        rv = measure_via_api(filepath)
        # 기대되는 rv 형식: {'current': int, 'total':int, 'absent':int}
        if rv and isinstance(rv, dict):
            recs = load_json(RECORDS_FILE, [])
            rec = {'id': int(time.time()*1000), 'time': datetime.now().isoformat(), 'current':int(rv.get('current',0)), 'total':int(rv.get('total',0)), 'absent':int(rv.get('absent',0))}
            recs.insert(0, rec); save_json(RECORDS_FILE, recs)
            self.load_stats()
            self._show_msg('측정 완료')
        else:
            self._show_msg('서버 응답 오류')

    def _show_msg(self, text):
        from kivy.uix.popup import Popup
        from kivy.uix.label import Label
        Popup(title='알림', content=Label(text=text), size_hint=(.7,.3)).open()

class TimetableScreen(Screen):
    def on_enter(self):
        self.render()

    def add_class(self, title, day, start, end):
        if not title or not start:
            return
        mapping = {'월':'mon','화':'tue','수':'wed','목':'thu','금':'fri'}
        day_key = mapping.get(day,'mon')
        tb = load_json(TIMETABLE_FILE, [])
        tb.append({'id': int(time.time()*1000),'title':title,'day':day_key,'start':start,'end':end})
        save_json(TIMETABLE_FILE, tb)
        self.render()

    def render(self):
        grid = self.ids.list_grid
        grid.clear_widgets()
        tb = load_json(TIMETABLE_FILE, [])
        for it in tb:
            from kivy.uix.boxlayout import BoxLayout
            from kivy.uix.label import Label
            from kivy.uix.button import Button
            b = BoxLayout(orientation='horizontal')
            b.add_widget(Label(text=f"{it['day']} {it['start']}-{it['end']} {it['title']}", halign='left', valign='middle'))
            btn = Button(text='삭제', size_hint_x=None, width=80)
            btn.bind(on_release=partial(self.delete_class, it['id']))
            b.add_widget(btn)
            grid.add_widget(b)

    def delete_class(self, id, *a):
        tb = load_json(TIMETABLE_FILE, [])
        tb = [t for t in tb if t['id']!=id]
        save_json(TIMETABLE_FILE, tb)
        self.render()

class TimerScreen(Screen):
    status_text = StringProperty('정지')
    timer_ev = None

    def start_timer(self, minutes_text):
        try:
            m = int(minutes_text)
            if m<=0: return
        except:
            return
        self.stop_timer()
        self.status_text = f'실행중 ({m}분)'
        # schedule interval in seconds
        self.timer_ev = Clock.schedule_interval(lambda dt: self._on_tick(), m*60)

    def stop_timer(self):
        if self.timer_ev:
            self.timer_ev.cancel(); self.timer_ev = None
        self.status_text = '정지'

    def _on_tick(self):
        # 자동 측정: 카메라 자동 촬영 또는 서버 연동 필요. 여기서는 시뮬레이션.
        simulated_current = max(0, int(10 + (time.time()%10)))
        simulated_total = simulated_current + 2
        simulated_absent = simulated_total - simulated_current
        recs = load_json(RECORDS_FILE, [])
        rec = {'id': int(time.time()*1000), 'time': datetime.now().isoformat(), 'current':simulated_current, 'total':simulated_total, 'absent':simulated_absent}
        recs.insert(0, rec); save_json(RECORDS_FILE, recs)

class RecordScreen(Screen):
    def on_enter(self):
        self.render()

    def render(self):
        grid = self.ids.recgrid
        grid.clear_widgets()
        recs = load_json(RECORDS_FILE, [])
        from kivy.uix.boxlayout import BoxLayout
        from kivy.uix.label import Label
        from kivy.uix.button import Button
        for r in recs:
            b = BoxLayout(orientation='horizontal')
            b.add_widget(Label(text=f"{r['time']}\n현재:{r['current']} 총:{r['total']} 결석:{r['absent']}", halign='left'))
            btn = Button(text='삭제', size_hint_x=None, width=80)
            btn.bind(on_release=partial(self.delete_record, r['id']))
            b.add_widget(btn)
            grid.add_widget(b)

    def delete_record(self, id, *a):
        recs = load_json(RECORDS_FILE, [])
        recs = [r for r in recs if r['id']!=id]
        save_json(RECORDS_FILE, recs)
        self.render()

    def clear_all(self):
        save_json(RECORDS_FILE, [])
        self.render()

    def export_csv(self):
        recs = load_json(RECORDS_FILE, [])
        if not recs:
            return
        path = os.path.join(DATA_DIR, 'lecture_records_export.csv')
        with open(path,'w',newline='',encoding='utf-8') as f:
            w = csv.writer(f)
            w.writerow(['time','current','total','absent'])
            for r in recs:
                w.writerow([r['time'], r['current'], r['total'], r['absent']])
        from kivy.uix.popup import Popup
        from kivy.uix.label import Label
        Popup(title='내보내기', content=Label(text=f'내보내기 위치: {path}'), size_hint=(.9,.3)).open()

# Network / API measure
def measure_via_api(filepath):
    # 실제 서버 구현에 맞게 수정하세요.
    # 예시: POST /api/measure 파일업로드, JSON 응답 {current:.., total:.., absent:..}
    SERVER_URL = 'https://your.api.server/measure'  # <-- 수정 필요
    if not requests:
        return None
    try:
        with open(filepath,'rb') as f:
            files = {'image': ('img.jpg', f, 'image/jpeg')}
            resp = requests.post(SERVER_URL, files=files, timeout=15)
            if resp.status_code==200:
                return resp.json()
    except Exception as e:
        print('measure error', e)
    return None

class LVApp(App):
    current_user = None

    def build(self):
        self.title = 'Lecture Vision'
        Builder.load_string(KV)
        sm = ScreenManager(transition=NoTransition())
        sm.add_widget(LoginScreen(name='login'))
        sm.add_widget(SignupScreen(name='signup'))
        sm.add_widget(HomeScreen(name='home'))
        sm.add_widget(TimetableScreen(name='timetable'))
        sm.add_widget(TimerScreen(name='timer'))
        sm.add_widget(RecordScreen(name='record'))
        return sm


if __name__ == '__main__':
    LVApp().run()

