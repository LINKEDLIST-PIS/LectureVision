DATA_DIR = os.path.join(App.get_running_app().user_data_dir if App.get_running_app() else '.', 'lv_data') if False else os.path.join(os.getcwd(), 'lv_data')
if not os.path.exists(DATA_DIR):
    os.makedirs(DATA_DIR, exist_ok=True)

